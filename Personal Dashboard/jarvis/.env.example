# Jarvis — environment variable reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.

# ── Auth.js ───────────────────────────────────────────────────────────────────

# Random secret used to sign JWTs and session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# GitHub OAuth App credentials.
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:          http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# ── Authorization allowlist ───────────────────────────────────────────────────

# The immutable numeric GitHub user ID of the sole authorized user.
# This is NOT a secret — GitHub user IDs are public. It is listed here for
# documentation and to make the allowlist explicit in configuration.
#
# Find your numeric ID: https://api.github.com/users/GuptaSantosh
# Expected value: 8694772
#
# IMPORTANT: Authorization is enforced by this numeric ID, not by username,
# email, or display name. Those are mutable and cannot be used safely.
AUTHORIZED_GITHUB_ID=8694772

# ── Reverse-proxy trust ───────────────────────────────────────────────────────

# Required when running behind nginx (or any reverse proxy) in production.
# Without this, Auth.js sets trustHost=false and every request fails with
# UntrustedHost. In development (NODE_ENV≠production) this is auto-set; in
# production it must be explicit.
AUTH_TRUST_HOST=true

# Optional — explicit canonical URL for Auth.js OAuth callback construction.
# If not set, Auth.js derives the URL from the Host header forwarded by nginx
# (proxy_set_header Host $host). Set this for extra explicitness or if the
# Host header is not forwarded correctly.
# AUTH_URL=https://jarvis.sageapps.in

# ── SQLite database ───────────────────────────────────────────────────────────

# Absolute path to the SQLite database file.
# Production: /home/jarvis/data/jarvis.db  (outside the git working tree)
# Development: omit this var — falls back to data/jarvis.dev.db (git-ignored)
#
# Before the first DB-backed startup on the server, run as root:
#   mkdir -p /home/jarvis/data && chown jarvis:users /home/jarvis/data && chmod 750 /home/jarvis/data
# Then run the migration BEFORE restarting the app:
#   npx drizzle-kit migrate
JARVIS_DB_PATH=/home/jarvis/data/jarvis.db

# ── Backup ────────────────────────────────────────────────────────────────────

# Absolute path to the directory where `npm run db:backup` writes backup files.
# Production: /home/jarvis/backups  (outside the git working tree)
# Development: set this to a local directory when testing the backup script.
#
# The directory must exist before running the backup — it is never created automatically.
# Before first use on the server, run as root:
#   mkdir -p /home/jarvis/backups && chown jarvis:users /home/jarvis/backups && chmod 750 /home/jarvis/backups
#
# Backup filenames are UTC-timestamped: jarvis_YYYYMMDD_HHmmssUTC.db
# Use `npm run db:backup` to create a backup manually.
JARVIS_BACKUP_DIR=/home/jarvis/backups

# ── AI evaluation ─────────────────────────────────────────────────────────────

# Anthropic API key — used server-side only by evaluateOpportunityAction.
# Never expose this to the client or commit it to source control.
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Optional / future ─────────────────────────────────────────────────────────

# Controls non-sensitive UI presentation hints only.
# NOT authentication. NOT authorization. See lib/config.ts for details.
# NEXT_PUBLIC_APP_MODE=private
